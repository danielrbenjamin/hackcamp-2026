# Set in your shell before Expo prebuild. Use an iOS bundle-restricted key.
GOOGLE_MAPS_IOS_API_KEY=
# Optional. Use the dashboard computer's .local hostname on the same network.
EXPO_PUBLIC_TELEMETRY_URL=
# A short-lived demo secret. Use the same value on the phone and dashboard.
EXPO_PUBLIC_TELEMETRY_TOKEN=
# Public HTTPS origin of the Windows dashboard/upload server (no /api suffix).
EXPO_PUBLIC_ML_UPLOAD_URL=
# Prototype upload authorization only; NOT a Databricks credential.
EXPO_PUBLIC_ML_UPLOAD_TOKEN=
# Server-only Databricks settings. Never prefix these with EXPO_PUBLIC_.
DATABRICKS_HOST=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Optional prototype alternative to OAuth service principal credentials.
DATABRICKS_TOKEN=
