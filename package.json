{
  "name": "smart-navigation-belt",
  "version": "0.1.0",
  "private": true,
  "main": "mobile/index.ts",
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "scripts": {
    "mobile": "expo start --dev-client",
    "mobile:web": "expo start --web",
    "ios": "expo run:ios --device",
    "dashboard": "vite --config dashboard/vite.config.ts",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test shared/*.test.ts plugins/*.test.cjs scripts/*.test.mjs",
    "lakehouse:setup": "node scripts/lakehouse.mjs setup",
    "lakehouse:test": "node --disable-warning=ExperimentalWarning --test shared/walkUploads.test.ts scripts/lakehouse.test.mjs",
    "lakehouse:check": "node scripts/lakehouse.mjs check",
    "lakehouse:start": "node scripts/lakehouse.mjs start"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@googlemaps/react-native-navigation-sdk": "0.19.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-location": "~58.0.20",
    "expo-sharing": "~58.0.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "vite": "^7.0.0"
  }
}
